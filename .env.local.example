# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it contains secrets for your local machine only.
#
# Find these in the Supabase dashboard:
# Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL
#   Your project URL, like https://xxxxxxxxxxxx.supabase.co
#
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   Your public API key. In the dashboard this may be labeled
#   "anon" / "public" or "publishable". Use that public key here.
#   Do NOT put the service_role / secret key in NEXT_PUBLIC_ vars.
#
# SUPABASE_SERVICE_ROLE_KEY
#   Secret server key from Project Settings → API.
#   Used only on the server to mark orders paid after Stripe confirms.
#   Never expose this in client code or commit it.
#
# Stripe (TEST mode for now):
# Developers → API keys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY starts with pk_test_
# STRIPE_SECRET_KEY starts with sk_test_
#
# NEXT_PUBLIC_SITE_URL
#   http://localhost:3000 for local development

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
